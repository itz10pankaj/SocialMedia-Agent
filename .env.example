# Copy this file to .env and fill in values. .env is never committed.

# --- Local LLM (Ollama) ---
# Laptop A (this laptop): http://localhost:11434
# Laptop B later: http://<laptop-B-IP>:11434   <- the only change needed to switch
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Used automatically if OLLAMA_URL is unreachable (leave empty to disable)
OLLAMA_FALLBACK_URL=http://localhost:11434
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# --- App ---
# Run the pipeline automatically when the app starts (set true once development is done)
RUN_ON_STARTUP=false

# --- Database (MySQL, required) ---
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/social_agent?charset=utf8mb4

# --- Email (step 5, not wired yet) ---
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# --- LinkedIn (step 6, not wired yet) ---
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
